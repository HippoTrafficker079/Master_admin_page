<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" spacing="14.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TeacherController">
   <children>
      <!-- Striking Page Title Header -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 14 20; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
         <children>
            <VBox spacing="3.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="👤" textFill="#1e3a8a">
                           <font><Font size="22.0" /></font>
                        </Label>
                        <Label text="MANAGE TEACHER" textFill="#1e3a8a">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                     </children>
                  </HBox>
                  <Label text="Faculty Directory &amp; Academic Staff Administration" textFill="#64748b">
                     <font><Font size="12.0" /></font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Search & Reset Bar -->
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
         <children>
            <TextField fx:id="searchField" onAction="#handleSearch"
                       promptText="Search teacher ID, name, department, position, or phone..."
                       prefHeight="38.0" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px; -fx-text-fill: #1e293b;" />
            <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="38.0" prefWidth="95.0"
			        styleClass="search-button" text="Search"
			        style="-fx-font-size: 13px;" />
			<Button mnemonicParsing="false" onAction="#handleReset" prefHeight="38.0" prefWidth="85.0"
			        styleClass="reset-button" text="Reset"
			        style="-fx-font-size: 13px;" />
         </children>
      </HBox>

      <!-- Hint Banner -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: #eff6ff; -fx-padding: 10 14; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;">
         <children>
            <Label text="💡  Select teacher row(s) below to remove (Hold Ctrl or Shift for multi-selection):" textFill="#1d4ed8">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="2.0" />
         </VBox.margin>
      </HBox>

      <!-- Table View with colTeacherId included -->
      <TableView fx:id="teacherTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="440.0" prefWidth="700.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colNo" prefWidth="45.0" text="No" />
          <TableColumn fx:id="colTeacherId" prefWidth="130.0" text="Teacher ID" />
          <TableColumn fx:id="colName" prefWidth="140.0" text="Name" />
          <TableColumn fx:id="colDepartment" prefWidth="160.0" text="" />
          <TableColumn fx:id="colPosition" prefWidth="160.0" text="" />
          <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone-no" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <!-- Bottom Action Buttons (Space-Evenly Layout matching StudentContent) -->
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="700.0" styleClass="buttoncontainer">
         <children>
            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="add" mnemonicParsing="false" onAction="#handleAdd" prefHeight="45.0" prefWidth="180.0" styleClass="rounded-button" text="+ Add Teacher">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="modify" mnemonicParsing="false" onAction="#handleModify" prefHeight="45.0" prefWidth="140.0" styleClass="rounded-button" text="Modify" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="remove" mnemonicParsing="false" onAction="#handleRemove" prefHeight="45.0" prefWidth="140.0" styleClass="rounded-button" text="Remove" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="restore" mnemonicParsing="false" onAction="#handleRestore" prefHeight="45.0" prefWidth="140.0" styleClass="rounded-button" text="Restore" />

            <Region HBox.hgrow="ALWAYS" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>