                          <ComboBox fx:id="comboAttendanceMajor" prefHeight="28.0" prefWidth="135.0" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11.5px;" />
                          <Label fx:id="lblAttendanceDateRange" text="📅  Mon 9 – Sat 14 Nov" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 5 12; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 11.5px;" />
                       </children>
                    </HBox>

                    <!-- Area Chart + Interactive Labels & Click Popup Overlay -->
                    <StackPane fx:id="attendanceChartWrapper" prefHeight="255.0">
                       <children>
                          <AreaChart fx:id="attendanceAreaChart"
                                     animated="false"
                                     prefHeight="255.0"
                                     legendVisible="false"
                                     horizontalGridLinesVisible="true"
                                     verticalGridLinesVisible="true"
                                     alternativeRowFillVisible="false"
                                     alternativeColumnFillVisible="false">
                            <xAxis>
                              <CategoryAxis fx:id="xAxisAttendance"
                                            label="Days of the Week"
                                            side="BOTTOM"
                                            tickMarkVisible="true" />
                            </xAxis>
                            <yAxis>
                              <NumberAxis fx:id="yAxisAttendance"
                                          label="Attendance (%)"
                                          side="LEFT"
                                          autoRanging="false"
                                          lowerBound="80.0"
                                          upperBound="100.0"
                                          tickUnit="5.0"
                                          minorTickCount="5"
                                          tickMarkVisible="true"
                                          minorTickVisible="true" />
                            </yAxis>
                          </AreaChart>

                          <!-- Transparent Overlay for Percentage Labels & Click Popup -->
                          <Pane fx:id="attendanceOverlayPane" pickOnBounds="false" />
                       </children>
                    </StackPane>
                 </children>
              </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>