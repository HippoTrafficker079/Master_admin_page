<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<VBox fx:id="rootPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="12.0" style="-fx-padding: 20; -fx-background-color: #eef2f7;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AttendanceController">
   <children>

      <!-- Head Title -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 14 20; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
         <children>
            <VBox spacing="3.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="📅" style="-fx-text-fill: #1e3a8a; -fx-font-size: 22px;" />
                        <Label text="ATTENDANCE MANAGEMENT" style="-fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 20px;" />
                     </children>
                  </HBox>
                  <Label text="Class Attendance Tracking, Daily Logs &amp; Student Audit Records" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Top Navigation Mode Bar (Fixed at top) -->
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10 15; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
         <children>
            <Button fx:id="btnClassView" mnemonicParsing="false" onAction="#switchToClassView" prefHeight="35.0" prefWidth="150.0" styleClass="search-button" text="CLASS VIEW">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            <Button fx:id="btnIndividualView" mnemonicParsing="false" onAction="#switchToIndividualView" prefHeight="35.0" prefWidth="200.0" styleClass="reset-button" text="INDIVIDUAL STUDENT VIEW">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBackToList" visible="false" managed="false" mnemonicParsing="false" onAction="#handleBackToList" prefHeight="35.0" prefWidth="150.0" styleClass="reset-button" text="🔙 Back to List" />
         </children>
      </HBox>

      <!-- Master ScrollPane wrapping everything below the Top Nav -->
      <ScrollPane fx:id="individualDashboardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS" style="-fx-background-color: transparent;">
         <content>
            <VBox spacing="12.0" style="-fx-padding: 2 4 10 2;">
               <children>

                  <!-- Sub-Mode Switcher (Class View Only) -->
                  <HBox fx:id="subModeBar" alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #e2e8f0; -fx-padding: 6 12; -fx-background-radius: 4;">
                     <children>
                        <Label text="Sub-Mode:" style="-fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 12px;" />
                        <Button fx:id="btnMatrixSummary" mnemonicParsing="false" onAction="#switchToMatrixSummary" prefHeight="26.0" prefWidth="140.0" styleClass="search-button" text="• Matrix Summary" />
                        <Button fx:id="btnDailyLog" mnemonicParsing="false" onAction="#switchToDailyLog" prefHeight="26.0" prefWidth="140.0" styleClass="reset-button" text="• Daily Log" />
                     </children>
                  </HBox>

                  <!-- Filter Panel 1: Matrix / Individual View Filters -->
                  <VBox fx:id="matrixFilterBox" spacing="12.0" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                     <children>
                        <Label text="Filter &amp; Search Attendance" textFill="#0f172a">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>

                        <!-- Row 1: Dropdowns + Start & End DatePickers -->
                        <HBox fx:id="matrixFilterRow1" alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <ComboBox fx:id="comboDepartment" prefHeight="34.0" prefWidth="155.0" promptText="Department" HBox.hgrow="SOMETIMES" />
                              <ComboBox fx:id="comboYear" prefHeight="34.0" prefWidth="135.0" promptText="Year" HBox.hgrow="SOMETIMES" />
                              <ComboBox fx:id="comboSubject" editable="true" prefHeight="34.0" prefWidth="275.0" promptText="Search Subject..." HBox.hgrow="ALWAYS" />
                              <DatePicker fx:id="startDatePicker" prefHeight="34.0" prefWidth="145.0" promptText="Start Date" HBox.hgrow="SOMETIMES" />
                              <DatePicker fx:id="endDatePicker" prefHeight="34.0" prefWidth="145.0" promptText="End Date" HBox.hgrow="SOMETIMES" />
                           </children>
                        </HBox>

                        <!-- Row 2: Search Student + Low Attendance Checkbox + Filter & Reset -->
                        <HBox fx:id="matrixFilterRow2" alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <TextField fx:id="searchField" prefHeight="34.0" prefWidth="260.0" promptText="Search student name or roll no..." styleClass="search-field" />
                              <CheckBox fx:id="chkLowAttendance" mnemonicParsing="false" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" text="Only show attendance &lt;75%" />
                              <Button fx:id="btnFilter" mnemonicParsing="false" onAction="#applyFilters" prefHeight="34.0" prefWidth="95.0" styleClass="search-button" text="Filter" />
                              <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleReset" prefHeight="34.0" prefWidth="95.0" styleClass="reset-button" text="↺ Reset" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Filter Panel 2: Daily Log Filters (Isolated) -->
                  <VBox fx:id="dailyFilterBox" managed="false" spacing="12.0" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" visible="false">
                     <children>
                        <Label text="Filter &amp; Search Daily Log" textFill="#0f172a">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <DatePicker fx:id="dailyDatePicker" minWidth="155.0" prefHeight="34.0" prefWidth="155.0" promptText="Log Date" />
                              <ComboBox fx:id="dailyPeriodCombo" prefHeight="34.0" prefWidth="140.0" promptText="Period" />
                              <TextField fx:id="dailySearchField" prefHeight="34.0" prefWidth="240.0" promptText="Search student or subject..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label text="Remarks / Status:" textFill="#1e3a8a"><font><Font name="System Bold" size="12.0" /></font></Label>
                              <CheckBox fx:id="chkPresent" mnemonicParsing="false" text="Present" />
                              <CheckBox fx:id="chkAbsent" mnemonicParsing="false" text="Absent" />
                              <CheckBox fx:id="chkExcuse" mnemonicParsing="false" text="Excuse" />
                              <Button mnemonicParsing="false" onAction="#applyFilters" prefHeight="34.0" prefWidth="95.0" styleClass="search-button" text="Filter" />
                              <Button mnemonicParsing="false" onAction="#handleReset" prefHeight="34.0" prefWidth="95.0" styleClass="reset-button" text="↺ Reset" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Hint Banners -->
                  <HBox fx:id="hintBoxMatrix" alignment="CENTER_LEFT" prefHeight="45.0" minHeight="45.0" maxHeight="45.0" styleClass="instruction-banner-box" style="-fx-background-color: #eff6ff; -fx-padding: 10 14; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;">
                     <children>
                        <Label text="💡  Hint: Double-click any student row in Matrix Summary to view detailed records in Individual Student View." style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 13px;" />
                     </children>
                  </HBox>

                  <!-- Striking Hint Banner 2 (Visible in Class View - Daily Log Only) -->
                  <HBox fx:id="hintBoxDaily" alignment="CENTER_LEFT" managed="false" style="-fx-background-color: #eff6ff; -fx-padding: 10 14; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;" styleClass="instruction-banner-box" visible="false">
                     <children>
                        <VBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Label text="💡  Hint: Select a row and click &quot;Toggle Status&quot; to cycle Present → Absent → Excused. For Excused rows, double-click Remarks, type a reason, press Enter, and click &quot;Save Changes&quot;." textFill="#1d4ed8" wrapText="true">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox fx:id="hintBoxIndiv" alignment="CENTER_LEFT" visible="false" managed="false" prefHeight="45.0" minHeight="45.0" maxHeight="45.0" styleClass="instruction-banner-box" style="-fx-background-color: #eff6ff; -fx-padding: 10 14; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;">
                     <children>
                        <Label text="💡  Hint: Double-click any student row in Matrix Summary or Daily Log to view detailed records." style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 13px;" />
                     </children>
                  </HBox>

                  <!-- MATRIX / DAILY TABLES CONTAINER -->
                  <VBox fx:id="classTablesContainer" spacing="12.0">
                     <children>
                        <!-- Matrix Summary Table -->
                        <TableView fx:id="matrixTable" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colNoMatrix" prefWidth="55.0" text="No" />
                            <TableColumn fx:id="colRollMatrix" prefWidth="135.0" text="Roll No" />
                            <TableColumn fx:id="colNameMatrix" prefWidth="240.0" text="Student Name" />
                            <TableColumn fx:id="colDeptMatrix" prefWidth="110.0" text="Dept" />
                            <TableColumn fx:id="colYearMatrix" prefWidth="140.0" text="Year" />
                            <TableColumn fx:id="colOverallMatrix" prefWidth="120.0" text="Overall %" />
                          </columns>
                        </TableView>

                        <!-- Daily Log Table -->
                        <TableView fx:id="dailyLogTable" visible="false" managed="false" prefHeight="450.0">
                          <columns>
                            <TableColumn fx:id="colNoLog" prefWidth="45.0" text="No" />
                            <TableColumn fx:id="colRollLog" prefWidth="80.0" text="Roll No" />
                            <TableColumn fx:id="colNameLog" prefWidth="135.0" text="Student Name" />
                            <TableColumn fx:id="colDateLog" prefWidth="95.0" text="Date" />
                            <TableColumn fx:id="colPeriodLog" prefWidth="65.0" text="Period" />
                            <TableColumn fx:id="colSubjLog" prefWidth="110.0" text="Subject" />
                            <TableColumn fx:id="colStatusLog" prefWidth="100.0" text="Status" />
                            <TableColumn fx:id="colMarkedByLog" prefWidth="85.0" text="Marked By" />
                            <TableColumn fx:id="colRemarksLog" prefWidth="90.0" text="Remarks" />
                          </columns>
                        </TableView>

                        <!-- Bottom Action Bar (Daily Log Only) -->
                        <HBox fx:id="saveChangesBox" alignment="CENTER_RIGHT" managed="false" spacing="12.0" style="-fx-padding: 10 0 0 0;" visible="false">
                           <children>
                              <Button fx:id="btnResetDailyStatus" mnemonicParsing="false" onAction="#handleResetDailyStatus" prefHeight="36.0" prefWidth="150.0" styleClass="reset-button" style="-fx-font-size: 13px;" text="↺ Reset Status" />
                              <Button fx:id="btnToggleStatus" mnemonicParsing="false" onAction="#handleToggleStatus" prefHeight="36.0" prefWidth="155.0" styleClass="toggle-status-button" text="⇄ Toggle Status" />
                              <Button fx:id="btnMarkAllPresent" mnemonicParsing="false" onAction="#handleMarkAllPresent" prefHeight="36.0" prefWidth="170.0" styleClass="mark-present-button" style="-fx-font-size: 13px;" text="✔ Mark All Present" />
                              <Button fx:id="btnSaveChanges" mnemonicParsing="false" onAction="#handleSaveChanges" prefHeight="36.0" prefWidth="160.0" styleClass="search-button" style="-fx-font-size: 13px;" text="💾 Save Changes" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ========================================================================= -->
                  <!-- INDIVIDUAL STUDENT VIEW FULL DASHBOARD -->
                  <!-- ========================================================================= -->
                  <VBox fx:id="individualDashboardContainer" spacing="14.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
                     <children>
                        <!-- Top Student Details Header Banner -->
                        <Label fx:id="studentHeaderLabel" text="👤  Student Details: III-CEIT-1 – Mg Mg"
                               style="-fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 16px;" />

                        <!-- SECTION 1: UNIVERSITY STUDENT PROFILE & METRICS -->
                        <VBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                           <children>
                              <!-- Section Header Bar -->
                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #dbeafe; -fx-padding: 9 16; -fx-background-radius: 7 7 0 0; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Label text="👤  University Student Profile"
                                           style="-fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                 </children>
                              </HBox>

                              <!-- Profile & Metrics Split Content -->
                              <HBox spacing="14.0" style="-fx-padding: 14;">
                                 <children>
                                    <!-- Left Card: Student Bio & Photo -->
                                    <HBox fx:id="indivProfileCard" spacing="14.0" alignment="CENTER_LEFT"
                                          style="-fx-background-color: white; -fx-padding: 12 14; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"
                                          prefWidth="345.0" minWidth="330.0">
                                       <children>
                                          <VBox alignment="CENTER"
                                                minWidth="90.0" prefWidth="90.0" maxWidth="90.0"
                                                minHeight="115.0" prefHeight="115.0" maxHeight="115.0"
                                                style="-fx-border-color: #395d87; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-border-radius: 6; -fx-background-radius: 6;">
                                             <children>
                                                <ImageView fx:id="indivProfileImage" fitHeight="109.0" fitWidth="84.0" pickOnBounds="true" preserveRatio="false" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="6.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label fx:id="lblIndivName" text="Mg Mg"
                                                       style="-fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 16.5px;" />

                                                <GridPane hgap="8.0" vgap="5.0">
                                                   <columnConstraints>
                                                      <ColumnConstraints minWidth="96.0" prefWidth="102.0" />
                                                      <ColumnConstraints minWidth="10.0" prefWidth="10.0" />
                                                      <ColumnConstraints hgrow="ALWAYS" minWidth="95.0" />
                                                   </columnConstraints>
                                                   <rowConstraints>
                                                      <RowConstraints minHeight="22.0" prefHeight="22.0" />
                                                      <RowConstraints minHeight="22.0" prefHeight="22.0" />
                                                      <RowConstraints minHeight="22.0" prefHeight="22.0" />
                                                      <RowConstraints minHeight="24.0" prefHeight="24.0" />
                                                   </rowConstraints>
                                                   <children>
                                                      <Label text="Student ID" styleClass="indiv-field-label" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" />
                                                      <Label fx:id="lblIndivStudentId" text="21-CEIT-01" styleClass="detail-field-value" GridPane.columnIndex="2" />

                                                      <Label text="Department" styleClass="indiv-field-label" GridPane.rowIndex="1" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                      <Label fx:id="lblIndivDept" text="CEIT" styleClass="detail-field-value" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                                                      <Label text="Year / Section" styleClass="indiv-field-label" GridPane.rowIndex="2" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                      <Label fx:id="lblIndivYearSec" text="III-CEIT-1" styleClass="detail-field-value" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                                                      <Label text="Status" styleClass="indiv-field-label" GridPane.rowIndex="3" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                      <Label fx:id="lblIndivStatusBadge"
                                                             style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-padding: 2 12; -fx-background-radius: 10; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 11.5px;"
                                                             text="Active" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                                   </children>
                                                </GridPane>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>

                                    <!-- Right Card: Overall University Attendance Metrics & Contact Summary -->
                                    <VBox fx:id="indivMetricsCard" spacing="0.0"
                                          style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"
                                          HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0"
                                                style="-fx-background-color: #f8fafc; -fx-padding: 7 14; -fx-background-radius: 5 5 0 0; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0;">
                                             <children>
                                                <Label text="📊  Overall University Attendance Metrics"
                                                       style="-fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                             </children>
                                          </HBox>
                                          <HBox spacing="12.0" alignment="CENTER_LEFT" style="-fx-padding: 12 14;" VBox.vgrow="ALWAYS">
                                             <children>
                                                <!-- Metrics Grid -->
                                                <GridPane hgap="8.0" vgap="10.0" alignment="CENTER_LEFT">
                                                   <columnConstraints>
                                                      <ColumnConstraints minWidth="148.0" prefWidth="154.0" />
                                                      <ColumnConstraints minWidth="10.0" prefWidth="10.0" />
                                                      <ColumnConstraints minWidth="68.0" prefWidth="74.0" />
                                                   </columnConstraints>
                                                   <rowConstraints>
                                                      <RowConstraints minHeight="24.0" prefHeight="24.0" />
                                                      <RowConstraints minHeight="24.0" prefHeight="24.0" />
                                                      <RowConstraints minHeight="26.0" prefHeight="26.0" />
                                                   </rowConstraints>
                                                   <children>
                                                      <Label text="☑  Total Attended" styleClass="indiv-field-label" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" />
                                                      <Label fx:id="lblTotalAttended" text="10" styleClass="detail-field-value" GridPane.columnIndex="2" />

                                                      <Label text="📅  Total Classes" styleClass="indiv-field-label" GridPane.rowIndex="1" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                      <Label fx:id="lblTotalClasses" text="12" styleClass="detail-field-value" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                                                      <Label text="🏅  Academic Standing" styleClass="indiv-field-label" GridPane.rowIndex="2" />
                                                      <Label text=":" styleClass="indiv-colon" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                      <Label fx:id="lblAcademicStanding"
                                                             minWidth="-Infinity"
                                                             style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-padding: 2 12; -fx-background-radius: 10; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 11.5px;"
                                                             text="Good" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                                   </children>
                                                </GridPane>

                                                <Separator orientation="VERTICAL" />

                                                <!-- Contact Summary -->
                                                <VBox spacing="7.0" alignment="CENTER_LEFT" minWidth="230.0" HBox.hgrow="ALWAYS">
                                                   <children>
                                                      <Label text="📞  Contact Summary"
                                                             style="-fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                                      <HBox spacing="7.0" alignment="CENTER_LEFT">
                                                         <children>
                                                            <Label text="✉" minWidth="-Infinity" style="-fx-text-fill: #395d87; -fx-font-size: 13px;" />
                                                            <Label fx:id="lblIndivEmail" text="aungaung@student.ytu.edu.mm" minWidth="-Infinity" styleClass="detail-field-value" />
                                                         </children>
                                                      </HBox>
                                                      <HBox spacing="7.0" alignment="CENTER_LEFT">
                                                         <children>
                                                            <Label text="📞" minWidth="-Infinity" style="-fx-text-fill: #395d87; -fx-font-size: 13px;" />
                                                            <Label fx:id="lblIndivPhone" text="09-333333333" minWidth="-Infinity" styleClass="detail-field-value" />
                                                         </children>
                                                      </HBox>
                                                      <HBox spacing="7.0" alignment="CENTER_LEFT">
                                                         <children>
                                                            <Label text="📍" minWidth="-Infinity" style="-fx-text-fill: #395d87; -fx-font-size: 13px;" />
                                                            <Label fx:id="lblIndivAddress" text="Mayangone Township, Yangon" styleClass="detail-field-value" HBox.hgrow="ALWAYS" />
                                                         </children>
                                                      </HBox>
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- SECTION 2: DEPARTMENT SUBJECT BREAKDOWN TABLE -->
                        <VBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #dbeafe; -fx-padding: 8 15; -fx-background-radius: 7 7 0 0; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Label text="📚  Department Subject Breakdown" style="-fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                 </children>
                              </HBox>

                              <TableView fx:id="individualTable" prefHeight="145.0" minHeight="145.0" maxHeight="165.0" style="-fx-border-width: 0;">
                                <columns>
                                  <TableColumn fx:id="colNoIndiv" prefWidth="50.0" maxWidth="65.0" text="No" />
                                  <TableColumn fx:id="colSubjIndiv" prefWidth="220.0" text="Course" />
                                  <TableColumn fx:id="colCourseCodeIndiv" prefWidth="130.0" text="Course Code" />
                                  <TableColumn fx:id="colAttendedIndiv" prefWidth="130.0" text="Attended / Total" />
                                  <TableColumn fx:id="colPercentageIndiv" prefWidth="130.0" text="Attendance Rate" />
                                  <TableColumn fx:id="colRemarksIndiv" prefWidth="140.0" text="Remarks" />
                                </columns>
                              </TableView>

                              <!-- Department Total Summary Footer Bar -->
                              <HBox alignment="CENTER_LEFT" spacing="0.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 0 0 7 7; -fx-border-color: #cbd5e1; -fx-border-width: 1 0 0 0; -fx-padding: 0 0 0 1;">
                                 <children>
                                    <Label prefWidth="${colNoIndiv.width}" minWidth="${colNoIndiv.width}" maxWidth="${colNoIndiv.width}" style="-fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1px 0 0; -fx-padding: 8 10;" />

                                    <Label alignment="CENTER_LEFT" prefWidth="${colSubjIndiv.width}" minWidth="${colSubjIndiv.width}" maxWidth="${colSubjIndiv.width}" text="Department Total" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 10; -fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1px 0 0;" />

                                    <Label alignment="CENTER" prefWidth="${colCourseCodeIndiv.width}" minWidth="${colCourseCodeIndiv.width}" maxWidth="${colCourseCodeIndiv.width}" text="–" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 10; -fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1px 0 0;" />

                                    <Label fx:id="lblDeptTotalAttended" alignment="CENTER" prefWidth="${colAttendedIndiv.width}" minWidth="${colAttendedIndiv.width}" maxWidth="${colAttendedIndiv.width}" text="138 / 160" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 10; -fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1px 0 0;" />

                                    <Label fx:id="lblDeptTotalRate" alignment="CENTER" prefWidth="${colPercentageIndiv.width}" minWidth="${colPercentageIndiv.width}" maxWidth="${colPercentageIndiv.width}" text="86.3%" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 10; -fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1px 0 0;" />

                                    <HBox alignment="CENTER" prefWidth="${colRemarksIndiv.width}" minWidth="${colRemarksIndiv.width}" maxWidth="${colRemarksIndiv.width}" style="-fx-padding: 8 10;">
                                       <children>
                                          <Label fx:id="lblDeptTotalStanding" style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-padding: 2 12; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 11px;" text="Good" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- SECTION 3: DETAILED CHRONOLOGICAL LOG -->
                        <VBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #dbeafe; -fx-padding: 8 15; -fx-background-radius: 7 7 0 0; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Label text="🗓  Detailed Chronological Log" style="-fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 13.5px;" />
                                 </children>
                              </HBox>

                              <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 12 14; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                 <children>
                                    <Label text="Filter &amp; Search Chronological Records" textFill="#0f172a">
                                       <font><Font name="System Bold" size="14.0" /></font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <ComboBox fx:id="comboIndivLogCourse" prefHeight="32.0" prefWidth="180.0" promptText="All Courses" />
                                          <ComboBox fx:id="comboIndivLogStatus" prefHeight="32.0" prefWidth="135.0" promptText="All Status" />
                                          <DatePicker fx:id="indivLogStartDate" minWidth="150.0" prefHeight="32.0" prefWidth="150.0" promptText="Start Date" />
                                          <DatePicker fx:id="indivLogEndDate" minWidth="150.0" prefHeight="32.0" prefWidth="150.0" promptText="End Date" />
                                          <Button mnemonicParsing="false" onAction="#applyIndivLogFilters" prefHeight="32.0" prefWidth="90.0" styleClass="search-button" text="Filter" />
                                          <Button mnemonicParsing="false" onAction="#resetIndivLogFilters" prefHeight="32.0" prefWidth="90.0" styleClass="reset-button" text="↺ Reset" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- Detailed Chronological Log Table -->
                              <TableView fx:id="chronologicalLogTable" prefHeight="272.0" minHeight="272.0" maxHeight="272.0" style="-fx-border-width: 0;">
                                <columns>
                                  <TableColumn fx:id="colNoChrono" prefWidth="50.0" maxWidth="65.0" text="No" />
                                  <TableColumn fx:id="colDateChrono" prefWidth="135.0" text="Date" />
                                  <TableColumn fx:id="colCourseChrono" prefWidth="200.0" text="Course" />
                                  <TableColumn fx:id="colCourseCodeChrono" prefWidth="110.0" text="Course Code" />
                                  <TableColumn fx:id="colStatusChrono" prefWidth="135.0" text="Attendance Status" />
                                  <TableColumn fx:id="colMarkedByChrono" prefWidth="135.0" text="Marked By" />
                                  <TableColumn fx:id="colRemarksChrono" prefWidth="150.0" text="Remarks" />
                                </columns>
                              </TableView>

                              <!-- Dynamic Pagination Footer Bar -->
                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f8fafc; -fx-padding: 10 15; -fx-background-radius: 0 0 7 7; -fx-border-color: #cbd5e1; -fx-border-width: 1 0 0 0;">
                                 <children>
                                    <Label fx:id="lblPaginationInfo" text="Showing 1 – 6 of 6 records" style="-fx-text-fill: #475569; -fx-font-size: 12px;" />
                                    <Region HBox.hgrow="ALWAYS" />

                                    <!-- Fixed-Position Arrows + Self-Centering Page Number Slot -->
                                    <Button fx:id="btnPrevPage" mnemonicParsing="false" onAction="#handlePrevPage" prefHeight="28.0" prefWidth="32.0" minWidth="32.0" maxWidth="32.0" styleClass="reset-button" text="&lt;" />
                                    <HBox alignment="CENTER" spacing="8.0" prefWidth="112.0" minWidth="112.0" maxWidth="112.0">
                                       <children>
                                          <Button fx:id="btnPage1" mnemonicParsing="false" onAction="#goToPage1" prefHeight="28.0" prefWidth="32.0" minWidth="32.0" maxWidth="32.0" styleClass="search-button" text="1" />
                                          <Button fx:id="btnPage2" mnemonicParsing="false" onAction="#goToPage2" prefHeight="28.0" prefWidth="32.0" minWidth="32.0" maxWidth="32.0" styleClass="reset-button" text="2" />
                                          <Button fx:id="btnPage3" mnemonicParsing="false" onAction="#goToPage3" prefHeight="28.0" prefWidth="32.0" minWidth="32.0" maxWidth="32.0" styleClass="reset-button" text="3" />
                                       </children>
                                    </HBox>
                                    <Button fx:id="btnNextPage" mnemonicParsing="false" onAction="#handleNextPage" prefHeight="28.0" prefWidth="32.0" minWidth="32.0" maxWidth="32.0" styleClass="reset-button" text="&gt;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>