<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="440.0" prefWidth="680.0" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 18;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TeacherRestoreController">
   <children>
      <!-- Prompt Instruction Header -->
      <Label text="Select faculty row(s) below to restore to the active teacher list:" textFill="#334155">
         <font>
            <Font size="13.5" />
         </font>
      </Label>

      <!-- Deleted Teachers Table View -->
      <TableView fx:id="deletedTable" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTeacherId" prefWidth="115.0" text="Teacher ID" />
          <TableColumn fx:id="colName" prefWidth="165.0" text="Full Name" />
          <TableColumn fx:id="colDepartment" prefWidth="85.0" text="Dept" />
          <TableColumn fx:id="colPosition" prefWidth="135.0" text="Position" />
          <TableColumn fx:id="colPhone" prefWidth="130.0" text="Phone" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <!-- Bottom Right Action Buttons -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnRestore" mnemonicParsing="false" onAction="#handleRestoreSelected" prefHeight="34.0" prefWidth="120.0" styleClass="dialog-restore-button" text="Restore" />
            <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#handleCancel" prefHeight="34.0" prefWidth="85.0" styleClass="reset-button" text="Cancel" />
         </children>
         <VBox.margin>
            <Insets top="4.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>